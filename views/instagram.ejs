<%- include("includes/head.ejs") %>
<body class="dark-theme">
    <%- include("includes/navbar.ejs") %>

    <main class="container">
        <!-- Profile Header -->
        <header class="glass-card profile-header">
            <div class="profile-info">
                <div class="avatar-placeholder">
                    <span><%= data.name.charAt(0).toUpperCase() %></span>
                </div>
                <div class="profile-details">
                    <h1>@<%= data.name %></h1>
                    <div class="profile-stats">
                        <div class="stat"><span class="stat-value"><%= data.posts.length %></span> posts</div>
                        <div class="stat"><span class="stat-value"><%= data.followers.toLocaleString() %></span> followers</div>
                        <div class="stat"><span class="stat-value"><%= data.following.toLocaleString() %></span> following</div>
                    </div>
                </div>
            </div>
            <div class="profile-actions">
                <button class="btn btn-primary">Follow</button>
                <button class="btn btn-secondary">Message</button>
            </div>
        </header>

        <!-- Profile Posts Gallery -->
        <section class="gallery-section">
            <hr class="divider">
            <div class="posts-grid">
                <% for(let post of data.posts){ %>
                    <div class="post-card">
                        <div class="post-image-wrapper">
                            <img src="<%= post.image %>" alt="Post by <%= data.name %>" class="post-image">
                            <div class="post-overlay">
                                <div class="overlay-stats">
                                    <span>❤️ <%= post.likes.toLocaleString() %></span>
                                    <span>💬 <%= post.comments.toLocaleString() %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <%- include("includes/footer.ejs") %>
    <script src="/app.js"></script>
</body>
</html>
